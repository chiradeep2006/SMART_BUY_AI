# SMARTBUY AI - Environment Variables Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/smartbuy_ai
# If MongoDB is not running locally, server uses robust in-memory/embedded fallback automatically

# Authentication
JWT_SECRET=smartbuy_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Retailer API Credentials (Optional - system falls back gracefully to transparent demo data if not configured)
AMAZON_API_KEY=
FLIPKART_API_KEY=
CROMA_API_KEY=
MYNTRA_API_KEY=
